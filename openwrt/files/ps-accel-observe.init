#!/bin/sh /etc/rc.common
# Passive device evidence remains available while the relay is stopped.
START=96
STOP=9
USE_PROCD=1

start_service() {
	procd_open_instance observer
	procd_set_param command /usr/sbin/ps-accel-observe
	procd_set_param nice 10
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param respawn 3600 10 5
	procd_set_param term_timeout 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ps_accel
}
